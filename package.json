{
  "name": "mediahub",
  "version": "0.1.0-preview.1",
  "description": "MediaHub local tool workbench",
  "author": "jerryrenjianxing-sys",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.cjs --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "semver": "7.8.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
